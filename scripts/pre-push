#!/usr/bin/env -S bash -p
# Pre-push hook: runs full test suite locally before push reaches GitHub.
# Permanent: provides fast local feedback and conserves GitHub Actions minutes.
# It also judges every push to master or main with ai-config's shared
# push-content gate (ADR-0091), loaded by the wiring block below.
# The next directive is FILE-WIDE (it precedes the first command), so it covers the
# whole hook, not only the wiring block. This repo's .shellcheckrc sets enable=all;
# the wiring block must stay byte-identical to ai-config's template, so its
# SC2249 (case without default), SC2310 and SC2311 (set -e disabled inside a
# condition or substitution) info findings are suppressed here instead. All three
# are deliberate in the block: its case arms fall through on purpose and its
# fetch/source chain is meant to run under || and &&.
# shellcheck disable=SC2249,SC2310,SC2311
set -e

# >>> push-content-gate wiring
# >>> _pcg_fetch
_pcg_fetch() { # <api path>; prints the raw file. curl reads no user-writable configuration; the token comes from gh's own store.
  local tok ca
  tok="$(gh auth token 2>/dev/null)" || return 1
  case "${tok}" in '' | *[!A-Za-z0-9_]*) return 1 ;; esac
  for ca in /etc/ssl/certs/ca-certificates.crt /etc/ssl/cert.pem ''; do [[ -r "${ca}" ]] && break; done
  [[ -n "${ca}" ]] || return 1
  printf 'header = "Authorization: Bearer %s"\n' "${tok}" \
    | env -i /usr/bin/curl -q --silent --show-error --fail --proto '=https' --noproxy '*' \
        --cacert "${ca}" --max-time 20 -K - -H 'Accept: application/vnd.github.raw' \
        "https://api.github.com/${1}"
}
# <<< _pcg_fetch
_pcg_refs="$(</dev/stdin)" || { printf 'pre-push: cannot read the pushed refs\n' >&2; exit 1; }
_pcg_hit=1
while read -r _ _ _pcg_rref _; do
  case "${_pcg_rref}" in refs/heads/master | refs/heads/main) _pcg_hit=0 ;; esac
done <<< "${_pcg_refs}"
if [[ "${_pcg_hit}" -eq 0 ]]; then
  # shellcheck disable=SC1090 # the library is fetched at runtime; there is no file to follow
  if _pcg_src="$(_pcg_fetch 'repos/brujack/ai-config/contents/.claude/hooks/push-content-gate.sh?ref=master')" \
    && source <(printf '%s\n' "${_pcg_src}") \
    && declare -F push_content_gate_refs >/dev/null; then
    push_content_gate_refs "${_pcg_refs}" "${2}" || exit 1
  else
    printf 'pre-push: cannot load the push-content gate from GitHub (brujack/ai-config master); refusing a push to master/main.\n' >&2
    printf 'Check the network and gh auth status, then retry.\n' >&2
    exit 1
  fi
fi
# <<< push-content-gate wiring


REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -z "${REPO_ROOT}" ]]; then
    _git_common="$(git rev-parse --git-common-dir)" || exit 1
    REPO_ROOT="$(cd "${_git_common}/.." && pwd)" || exit 1
fi

needs_test=0
if [[ -n "${_pcg_refs}" ]]; then
# shellcheck disable=SC2034 # git's pre-push protocol supplies four whitespace-separated
# fields per ref on stdin; local_ref and remote_ref must be named to consume the line
# positionally even though only the two SHAs are read below.
while read -r local_ref local_sha remote_ref remote_sha; do
    [[ "${local_sha}" == "0000000000000000000000000000000000000000" ]] && continue

    if [[ "${remote_sha}" == "0000000000000000000000000000000000000000" ]]; then
        base="$(git merge-base "${local_sha}" origin/main 2>/dev/null \
            || git rev-list --max-parents=0 "${local_sha}")"
        range="${base}..${local_sha}"
    else
        range="${remote_sha}..${local_sha}"
    fi

    # Fail closed, per ADR-0017's finding in dotfiles: piping git diff into grep
    # discards git's exit status, so an unresolvable range (a remote_sha naming
    # an object this checkout lacks) yields no matches and reads as "nothing
    # changed" — silently skipping the tests this hook exists to run. Capture
    # the status before anything else can clobber it.
    # `|| _diff_rc=$?` rather than `; _diff_rc=$?`: set -e is on, and a bare
    # assignment is a simple command, so errexit aborts the shell on git's
    # non-zero status before the following statement can run. Putting it in an
    # AND-OR list exempts it from errexit and captures the status in the same
    # breath. Verified by A/B: the bare form exits 128 and never reaches the
    # branch below.
    _diff_rc=0
    _changed="$(git diff --name-only "${range}")" || _diff_rc=$?
    if [[ "${_diff_rc}" -ne 0 ]]; then
        printf 'pre-push: cannot resolve %s — running tests rather than assuming nothing changed\n' "${range}" >&2
        needs_test=1
    elif printf '%s\n' "${_changed}" | grep -qE '\.rs$|^Cargo\.(toml|lock)$|^tests/|^scripts/'; then
        needs_test=1
    fi
done <<< "${_pcg_refs}"
fi

[[ "${needs_test}" -eq 0 ]] && exit 0

printf "Running tests locally (pre-push)...\n"
make -C "${REPO_ROOT}" test
