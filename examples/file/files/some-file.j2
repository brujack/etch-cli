# Generated by etch — do not edit manually
#
# Template variable reference:
#   user.username     — login name
#   user.home_dir     — home directory path
#   user.name         — display name
#   os.name           — "macos" | "linux"
#   os.family         — "darwin" | "linux"
#   os.hostname       — machine hostname
#   variables.<key>   — values from etch.yaml variables: section
#   env.<KEY>         — environment variables
#   manifest_dir      — absolute path to the manifest directory

username = {{ user.username }}
home = {{ user.home_dir }}
hostname = {{ os.hostname }}

# Variable from etch.yaml `variables:` section — NOT bare `{{ my_var }}`
profile = {{ variables.profile | default(value="default") }}

# Environment variable
editor = {{ env.EDITOR | default(value="vim") }}

# Conditional block
{% if os.name == "macos" %}
platform_note = macOS-specific config
{% else %}
platform_note = Linux config
{% endif %}

# Loop over a list variable (requires `variables.my_list` in etch.yaml)
{% for item in variables.my_list | default(value=[]) %}
item = {{ item }}
{% endfor %}

# Read another file into the template
# inline_cert = {{ read_file_contents(path="/path/to/cert.pem") }}
