enable=all
source-path=SCRIPTDIR
disable=SC2154

# Shared fleet baseline (dotfiles/.shellcheckrc, ai-config/.shellcheckrc,
# math/.shellcheckrc, terraform_ansible/.shellcheckrc): SC1091 is structurally
# unavoidable wherever a script sources a path resolved at runtime via
# $(dirname "${BASH_SOURCE[0]}"), which does not exist at lint time.
#
# This repo keeps `enable=all` and `source-path=SCRIPTDIR` on top of that
# baseline deliberately — that extra strictness is a per-repo choice, not
# drift from the shared minimal config the other three repos use.
disable=SC1091
